# 用户层 modules 模块 — 门禁 DUST_MOD_DEV_XXX（跟架构层 modules 同风格）
# Kconfig 由 zephyr/module.yml 自动加载（build.kconfig: Kconfig），无需 rsource。
#
# 新增内容时照这块追加：
#
# config DUST_MOD_DEV_XXX
#     bool "XXX"
#     default n
#     help
#       XXX 说明。

# ============================================================================

# =================            DUST_MOD_DEV_CHASSIS        ====================

config DUST_MOD_DEV_CHASSIS
    bool "Chassis motor feedback"
    default n
    select DUST_COM_CAN
    select DUST_MOD_DEV_MOTOR_DJI
    help
      Assemble four C620 motors on CAN1 and expose feedback snapshots.
